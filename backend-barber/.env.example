# Archivo de ejemplo de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales antes de ejecutar

# DB
MONGODB_URI=mongodb://localhost:27017/backend-barber?directConnection=true
MONGO_URI=mongodb://localhost:27017/backend-barber?directConnection=true

# Server
PORT=3000
# Reemplaza por un secreto fuerte en producción
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_PARTIAL_SECRET=your_jwt_partial_secret_here

# Mail (Ethereal para pruebas)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# Usuario y contraseña de ejemplo — NO subir credenciales reales a git
SMTP_USER=your_ethereal_user@example.com
SMTP_PASS=your_ethereal_password
SMTP_SECURE=false

# Mail sender + frontend url para enlaces
EMAIL_FROM=no-reply@miapp.local
FRONTEND_URL=http://localhost:5173

# CORS — múltiples orígenes separados por coma
CORS_ORIGIN=http://localhost:5173

# CORS — múltiples orígenes separados por coma
CORS_ORIGIN=http://localhost:5173

# Token reset
RESET_TOKEN_EXPIRATION_MIN=60

# Appointments
CANCEL_MIN_HOURS_BEFORE=2
MAX_ADVANCE_DAYS=30

# HMAC secret for refresh token hashing
REFRESH_HASH_SECRET=your-refresh-hmac-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# MercadoPago
MP_ACCESS_TOKEN=TEST-your_access_token_here
MP_PUBLIC_KEY=TEST-your_public_key_here
MP_WEBHOOK_SECRET=your_webhook_secret
MP_NOTIFICATION_URL=https://tudominio.com/api/payments/webhook

# Memberships
MEMBERSHIP_PRICE_UYU=399

# Telegram Bot (opcional — dejar en false si no se usa)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=http://localhost:3000/api