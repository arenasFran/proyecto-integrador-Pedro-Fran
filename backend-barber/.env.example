# Archivo de ejemplo de variables de entorno
# Copia este archivo a `.env` y rellena los valores reales antes de ejecutar

# Seed automático al iniciar el servidor. ¡Cuidado! Borra membresías,
# transacciones y recrea datos de demo. Dejar en false en producción.
SEED_ON_START=false

# DB
MONGODB_URI=mongodb://localhost:27017/backend-barber?directConnection=true
MONGO_URI=mongodb://localhost:27017/backend-barber?directConnection=true

# Server
PORT=3000
# Reemplaza por un secreto fuerte en producción
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_PARTIAL_SECRET=your_jwt_partial_secret_here

# Mail — proveedor de envío: "ethereal" (testing, no entrega mails reales) o "brevo" (producción)
EMAIL_PROVIDER=brevo

# SMTP:
# - En modo "ethereal": generá una cuenta de test en https://ethereal.email y usá esas credenciales.
#   Los mails no se entregan de verdad; la URL de preview se loguea por consola al enviar.
# - En modo "brevo": usá las credenciales SMTP de tu cuenta de Brevo (SMTP & API → SMTP).
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
# Usuario y contraseña de ejemplo — NO subir credenciales reales a git
SMTP_USER=your_ethereal_user@example.com
SMTP_PASS=your_ethereal_password
SMTP_SECURE=false

# Mail sender + frontend url para enlaces
# Con EMAIL_PROVIDER=brevo, EMAIL_FROM es OBLIGATORIO y debe:
#   1) ser un sender verificado en tu cuenta de Brevo (Senders & IP → Senders)
#   2) tener el formato "Nombre <email@dominio>" — si no, el server no arranca.
# Ejemplo: EMAIL_FROM="Tu Negocio <no-reply@tudominio.com>"
EMAIL_FROM=no-reply@miapp.local
FRONTEND_URL=http://localhost:5174

# CORS — múltiples orígenes separados por coma, sin barra final
# Producción: https://barberiasantiagoabbona.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Token reset
RESET_TOKEN_EXPIRATION_MIN=60

# Appointments
CANCEL_MIN_HOURS_BEFORE=2
MAX_ADVANCE_DAYS=30

# HMAC secret for refresh token hashing
REFRESH_HASH_SECRET=your-refresh-hmac-secret

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# MercadoPago
MP_ACCESS_TOKEN=TEST-your_access_token_here
MP_PUBLIC_KEY=TEST-your_public_key_here
MP_WEBHOOK_SECRET=your_webhook_secret
MP_NOTIFICATION_URL=https://tudominio.com/api/payments/webhook

# Memberships
MEMBERSHIP_PRICE_UYU=399

# Telegram Bot (opcional — dejar en false si no se usa)
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_BASE_URL=http://localhost:3000/api
TELEGRAM_BOT_USERNAME=BarberiaSAbot
# Requerido si TELEGRAM_BOT_ENABLED=true: clave para cifrar en reposo el refresh
# token de las cuentas vinculadas a Telegram (AES-256-GCM). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_TOKEN_ENC_KEY=

# Gemini — compartida por el texto libre del bot de Telegram y la
# recomendación de corte con IA (opcional en ambos casos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# AI Haircut Recommendation (Rekognition)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# AI Haircut Example Image (OpenAI dall-e-2)
OPENAI_API_KEY=
